@model IEnumerable<SinhVien>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách sinh viên</h1>
    <a class="btn btn-primary" asp-action="Create">Thêm sinh viên</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto"><input name="tuKhoa" value="@ViewData["TuKhoa"]" class="form-control" placeholder="Tìm mã hoặc họ tên" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-secondary">Tìm kiếm</button></div>
    <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a></div>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-light"><tr><th>Mã sinh viên</th><th>Họ và tên</th><th>Ngày sinh</th><th>Giới tính</th><th>Email</th><th>Lớp</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.MaSinhVien</td><td>@item.HoTen</td><td>@item.NgaySinh?.ToString("dd/MM/yyyy")</td><td>@item.GioiTinh</td><td>@item.Email</td><td>@item.Lop</td>
            <td class="text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id">Xem</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Xóa</a>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-center">Chưa có sinh viên nào.</td></tr> }
    </tbody>
</table>

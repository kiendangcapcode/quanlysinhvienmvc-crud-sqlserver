@model SinhVien
@{
    ViewData["Title"] = "Chi tiết sinh viên";
}
<h1>Chi tiết sinh viên</h1>
<hr />
<div class="row">
    <div class="col-md-3 mb-3">
        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
        {
            <img src="@Model.ImagePath" alt="Ảnh của @Model.HoTen" class="img-fluid rounded" style="max-height: 260px; object-fit: cover;" />
        }
        else
        {
            <div class="border rounded p-4 text-center text-muted">Chưa có ảnh</div>
        }
    </div>
    <dl class="row col-md-9">
        <dt class="col-sm-3">Mã sinh viên</dt><dd class="col-sm-9">@Model.MaSinhVien</dd>
        <dt class="col-sm-3">Họ và tên</dt><dd class="col-sm-9">@Model.HoTen</dd>
        <dt class="col-sm-3">Ngày sinh</dt><dd class="col-sm-9">@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Giới tính</dt><dd class="col-sm-9">@Model.GioiTinh</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Lớp</dt><dd class="col-sm-9">@Model.Lop</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>

@model SinhVien
@{
    ViewData["Title"] = "Xóa sinh viên";
}
<h1>Xóa sinh viên</h1>
<p>Bạn có chắc muốn xóa sinh viên này không?</p>
<dl class="row">
    <dt class="col-sm-3">Mã sinh viên</dt><dd class="col-sm-9">@Model.MaSinhVien</dd>
    <dt class="col-sm-3">Họ và tên</dt><dd class="col-sm-9">@Model.HoTen</dd>
    <dt class="col-sm-3">Lớp</dt><dd class="col-sm-9">@Model.Lop</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
